VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local development: the Vite dev server proxies /api to http://localhost:5000.
# Production (Vercel): set this to the full backend URL, e.g.
#   VITE_API_URL=https://your-backend.onrender.com/api
# Leaving it unset in production makes requests hit Vercel's SPA fallback instead
# of the API, because vercel.json has no /api rewrite.
VITE_API_URL=http://localhost:5000/api
