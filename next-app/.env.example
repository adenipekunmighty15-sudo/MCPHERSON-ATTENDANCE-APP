# Optional origin of the legacy Vue portal (used by the current marketing shell).
NEXT_PUBLIC_PORTAL_URL=http://localhost:5173

# Browser API base. Leave unset for same-origin /api (proxied by next.config.mjs
# when API_ORIGIN is set, or served by the Next app on the same origin).
# Set an absolute backend origin only when the browser must call it directly.
# NEXT_PUBLIC_API_URL=https://api.example.edu.ng

# Server-only backend origin used by the /api/:path* and /uploads/:path* rewrites.
# Never prefix this with NEXT_PUBLIC_ — it may point at an internal host.
# API_ORIGIN=https://mcpherson-attendance-api.onrender.com

# Public Supabase bootstrap values. These are public by design. If either is
# absent, the browser fetches GET /api/public/config at runtime instead.
# Never put a service_role key here or in any NEXT_PUBLIC_* variable.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Absolute public origin used when building auth redirect URLs (optional).
# NEXT_PUBLIC_SITE_URL=https://portal.mcu.edu.ng
