# Database connection string (PostgreSQL, e.g. from Supabase)
# Direct connection: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Transaction pooler: postgresql://postgres.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Server port
PORT=5000

# Set to 'true' to bypass all AI API calls during development (returns simulated responses)
AI_SAFE_MODE=false

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Supabase service key (for server-side admin operations)
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# VITE_SUPABASE_URL (needed here for backend Supabase admin client)
VITE_SUPABASE_URL=https://your-project.supabase.co

# ─── Open-Ended API Keys ───
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── NVIDIA API Keys (each model gets its OWN key) ───
# Get from: https://build.nvidia.com/

# Transcription
NVIDIA_WHISPER_KEY=your_nvidia_whisper_key_here

# AI Council providers - each with individual key
HERMES_API_KEY=your_hermes_api_key_here
NVIDIA_LLAMA_KEY=your_nvidia_llama_key_here
NVIDIA_ULTRA_KEY=your_nvidia_ultra_key_here
NVIDIA_ULTRA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NANO_KEY=your_nvidia_nano_key_here
NVIDIA_NEMOTRON_KEY=your_nvidia_nemotron_key_here

# DeepSeek + Phi-4 (individual keys)
DEEPSEEK_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
PHI4_KEY=your_phi4_key_here
PHI4_MODEL=microsoft/phi-4-mini-instruct

# MiniMax + DiffusionGemma (individual keys)
MINIMAX_KEY=your_minimax_key_here
DIFFUSIONGEMMA_KEY=your_diffusiongemma_key_here

# StepFun (individual key)
STEPFUN_KEY=your_stepfun_key_here

# Mistral + Kimi + Gemma (each with own key)
MISTRAL_NEMOTRON_KEY=your_mistral_nemotron_key_here
KIMI_KEY=your_kimi_key_here
MISTRAL_LARGE_KEY=your_mistral_large_key_here
GEMMA4_KEY=your_gemma4_key_here

# Z-AI (GLM model on NVIDIA API)
ZAI_KEY=your_zai_key_here
ZAI_MODEL=z-ai/glm-5.2

# Alternate NVIDIA Ultra key (used by nemotron-ultra provider)
NVIDIA_ULTRA_KEY_2=your_nvidia_ultra_key_2_here

# DeepSeek V4 Flash (separate key)
DEEPSEEK_V4_FLASH_KEY=your_deepseek_v4_flash_key_here
DEEPSEEK_V4_FLASH_MODEL=deepseek-ai/deepseek-v4-flash

# Alternate DeepSeek V4 Pro key (backup for existing DEEPSEEK_KEY)
DEEPSEEK_V4_PRO_KEY=your_deepseek_v4_pro_key_here

# ─── Study Hub RAG & Vectorization ───
NV_EMBEDDER_KEY=your_nv_embedder_key_here
NV_RETRIEVER_KEY=your_nv_retriever_key_here
NV_DOCUMENT_KEY=your_nv_document_key_here
NV_LAYOUT_KEY=your_nv_layout_key_here

# ─── External Integrations (free API keys — set to use) ───
# ElevenLabs TTS — premium voice for The Mind (free tier: 10k chars/month)
# Get key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenWeather — weather brief in Mind's daily greeting (free tier: 1M calls/month)
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# YouTube Data API v3 — video recommendations for study topics (free: 10k units/day)
# Get key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Wolfram Alpha — math problem solver in Mind chat (free tier: 2000 queries/month)
# Get App ID at: https://developer.wolframalpha.com/portal/myapps/
WOLFRAM_APP_ID=

# Spotify — study focus playlists (free: client credentials flow)
# Get at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Twilio — WhatsApp chat with Mind outside the app
# Get at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# News API — campus-relevant news feed (free tier: 100 requests/day)
# Get key at: https://newsapi.org/register
NEWS_API_KEY=

# Google Maps — campus navigation, directions to lecture halls
# Get key at: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
GOOGLE_MAPS_API_KEY=

# Discord Webhooks — Mind sends notifications to your server channel
# Create webhook at: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# GitHub — track repos, commits, profile for CS students
# Create classic token at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# Google Calendar OAuth — full timetable sync with user auth
# Create OAuth 2.0 credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase anon/public key (used by frontend)
# Get from: Supabase Dashboard → Project Settings → API → anon (public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI GPT-OSS models on NVIDIA API
GPT_OSS_20B_KEY=your_gpt_oss_20b_key_here
GPT_OSS_20B_MODEL=openai/gpt-oss-20b
GPT_OSS_120B_KEY=your_gpt_oss_120b_key_here
GPT_OSS_120B_MODEL=openai/gpt-oss-120b

# Whisper alt key (backup for transcription)
NVIDIA_WHISPER_KEY_2=your_nvidia_whisper_key_2_here

# Nemotron Super 120B
NVIDIA_SUPER_120B_KEY=your_nvidia_super_120b_key_here
NVIDIA_SUPER_120B_MODEL=nvidia/nemotron-3-super-120b-a12b

# Llama 3.3 70B (NVIDIA key)
LLAMA33_KEY=your_llama33_key_here

# Nemotron Super 49B v1.5
NVIDIA_SUPER_49B_V15_KEY=your_nvidia_super_49b_v15_key_here

# Nemotron Super 49B v1
NVIDIA_SUPER_49B_V1_KEY=your_nvidia_super_49b_v1_key_here

# Nemotron Nano alt key
NVIDIA_NANO_KEY_2=your_nvidia_nano_key_2_here

# Mistral Nemotron alt key
MISTRAL_NEMOTRON_KEY_2=your_mistral_nemotron_key_2_here
